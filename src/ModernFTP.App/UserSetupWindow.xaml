<Window x:Class="ModernFTP.App.UserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModernFTP.App"
        Title="{x:Static local:Strings.UserSetupTitle}"
        Width="780"
        Height="620"
        MinWidth="700"
        MinHeight="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="460" />
            <Button x:Name="SaveButton" Content="{x:Static local:Strings.SetupSave}" IsDefault="True" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="{x:Static local:Strings.SetupClose}" IsCancel="True" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,14,0">
                <Label DockPanel.Dock="Top" Content="{x:Static local:Strings.UserList}" Target="{Binding ElementName=UserBox}" Margin="0,0,0,4" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="NewButton" Content="{x:Static local:Strings.UserNew}" Click="OnNewUser" />
                    <Button x:Name="CopyButton" Content="{x:Static local:Strings.UserCopy}" Click="OnCopyUser" />
                    <Button x:Name="RenameButton" Content="{x:Static local:Strings.UserRename}" Click="OnRenameUser" />
                    <Button x:Name="DeleteButton" Content="{x:Static local:Strings.UserDelete}" Click="OnDeleteUser" />
                </StackPanel>
                <ListBox x:Name="UserBox" SelectionChanged="OnUserChanged" KeyDown="OnUserKeyDown" />
            </DockPanel>
            <TabControl x:Name="Tabs" Grid.Column="1">
                <TabItem x:Name="MainTab" Header="{x:Static local:Strings.UserTabMain}">
                    <Grid x:Name="MainPanel" Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="EnabledBox" Grid.ColumnSpan="3" Content="{x:Static local:Strings.UserEnabled}" Click="OnEnabledClick" />
                        <Label Grid.Row="1" Content="{x:Static local:Strings.UserPassword}" Target="{Binding ElementName=PasswordBox}" />
                        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,3" VerticalAlignment="Center" />
                        <Button x:Name="SetPasswordButton" Grid.Row="1" Grid.Column="2" Content="{x:Static local:Strings.UserSetPassword}" Margin="8,0,0,0" HorizontalAlignment="Left" Click="OnSetPassword" />
                        <TextBlock x:Name="PasswordStatus" Grid.Row="2" Grid.ColumnSpan="3" Opacity="0.7" Margin="0,0,0,14" TextWrapping="Wrap" />
                        <Label Grid.Row="3" Content="{x:Static local:Strings.UserMaxConnections}" Target="{Binding ElementName=UserMaxConnBox}" />
                        <TextBox x:Name="UserMaxConnBox" Grid.Row="3" Grid.Column="1" IsEnabled="False" />
                        <Label Grid.Row="4" Content="{x:Static local:Strings.UserMaxPerIp}" Target="{Binding ElementName=UserMaxIpBox}" />
                        <TextBox x:Name="UserMaxIpBox" Grid.Row="4" Grid.Column="1" IsEnabled="False" />
                        <Label Grid.Row="5" Content="{x:Static local:Strings.UserIdleTimeout}" Target="{Binding ElementName=UserIdleBox}" />
                        <TextBox x:Name="UserIdleBox" Grid.Row="5" Grid.Column="1" IsEnabled="False" />
                        <TextBlock Grid.Row="3" Grid.RowSpan="3" Grid.Column="2" Text="{x:Static local:Strings.UserLimitsComing}" Opacity="0.7" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                        <Label Grid.Row="6" Content="{x:Static local:Strings.UserDownloadSpeed}" Target="{Binding ElementName=SpeedBox}" Margin="0,14,12,3" />
                        <TextBox x:Name="SpeedBox" Grid.Row="6" Grid.Column="1" Margin="0,14,0,3" TextChanged="OnSpeedChanged" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{x:Static local:Strings.UserDownloadSpeedHint}" Opacity="0.7" VerticalAlignment="Center" Margin="12,14,0,0" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="DirectoryTab" Header="{x:Static local:Strings.UserTabDirectories}">
                    <DockPanel x:Name="DirectoryPanel" Margin="12">
                        <GroupBox DockPanel.Dock="Bottom" Header="{x:Static local:Strings.UserRights}" Margin="0,8,0,0" Padding="8,4">
                            <UniformGrid Columns="3">
                                <CheckBox x:Name="RightDownload" Content="{x:Static local:Strings.RightDownload}" Click="OnRightClick" />
                                <CheckBox x:Name="RightUpload" Content="{x:Static local:Strings.RightUpload}" Click="OnRightClick" />
                                <CheckBox x:Name="RightDelete" Content="{x:Static local:Strings.RightDelete}" Click="OnRightClick" />
                                <CheckBox x:Name="RightMakeDir" Content="{x:Static local:Strings.RightMakeDir}" Click="OnRightClick" />
                                <CheckBox x:Name="RightRemoveDir" Content="{x:Static local:Strings.RightRemoveDir}" Click="OnRightClick" />
                                <CheckBox x:Name="RightRename" Content="{x:Static local:Strings.RightRename}" Click="OnRightClick" />
                                <CheckBox x:Name="RightList" Content="{x:Static local:Strings.RightList}" Click="OnRightClick" />
                            </UniformGrid>
                        </GroupBox>
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static local:Strings.UserDirPath}" Target="{Binding ElementName=DirPathBox}" />
                            <TextBox x:Name="DirPathBox" Grid.Column="1" />
                            <Label Grid.Row="1" Content="{x:Static local:Strings.UserDirAlias}" Target="{Binding ElementName=DirAliasBox}" />
                            <TextBox x:Name="DirAliasBox" Grid.Row="1" Grid.Column="1" />
                            <CheckBox x:Name="DirSubBox" Grid.Row="2" Grid.Column="1" Content="{x:Static local:Strings.UserDirSubdirs}" IsChecked="True" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="{x:Static local:Strings.UserDirAdd}" Margin="0,0,8,0" Click="OnDirAdd" />
                                <Button x:Name="DirEditButton" Content="{x:Static local:Strings.UserDirEdit}" Margin="0,0,8,0" Click="OnDirEdit" />
                                <Button x:Name="DirRemoveButton" Content="{x:Static local:Strings.UserDirRemove}" Click="OnDirRemove" />
                            </StackPanel>
                        </Grid>
                        <Label DockPanel.Dock="Top" Content="{x:Static local:Strings.UserDirectories}" Target="{Binding ElementName=DirBox}" Margin="0,0,0,4" />
                        <ListBox x:Name="DirBox" SelectionChanged="OnDirChanged" />
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="IpTab" Header="{x:Static local:Strings.UserTabIp}">
                    <TextBlock Text="{x:Static local:Strings.UserIpComing}" Opacity="0.7" Margin="14" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
