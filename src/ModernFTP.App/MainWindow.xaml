<Window x:Class="ModernFTP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModernFTP.App"
        Title="{x:Static local:Strings.AppName}"
        MinWidth="640"
        MinHeight="360"
        Width="860"
        Height="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static local:Strings.MenuFile}">
                <MenuItem Header="{x:Static local:Strings.MenuExit}" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="{x:Static local:Strings.MenuServer}">
                <MenuItem x:Name="StartItem" Header="{x:Static local:Strings.MenuStart}" Click="OnStart" />
                <MenuItem x:Name="StopItem" Header="{x:Static local:Strings.MenuStop}" Click="OnStop" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="{x:Static local:Strings.MenuSetup}">
                <MenuItem Header="{x:Static local:Strings.MenuFtpSetup}" Click="OnSetup" />
                <MenuItem Header="{x:Static local:Strings.MenuUsers}" Click="OnUsers" />
            </MenuItem>
            <MenuItem Header="{x:Static local:Strings.MenuTray}">
                <MenuItem Header="{x:Static local:Strings.MenuMinimizeToTray}" Click="OnMinimizeToTray" />
            </MenuItem>
            <MenuItem Header="{x:Static local:Strings.MenuHelp}">
                <MenuItem Header="{x:Static local:Strings.MenuAbout}" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StateText" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="ConnectionsText" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="SentText" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="ReceivedText" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="MessageText" />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="Tabs" Margin="8">
            <TabItem x:Name="LogTab" Header="{x:Static local:Strings.TabLog}">
                <RichTextBox x:Name="LogBox"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, Courier New"
                             FontSize="12"
                             Margin="0,6,0,0">
                    <RichTextBox.Document>
                        <FlowDocument PageWidth="5000" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" />
                    </RichTextBox.Document>
                </RichTextBox>
            </TabItem>
            <TabItem x:Name="UsersTab" Header="{x:Static local:Strings.TabUsers}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="UsersList" SelectionChanged="OnSelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static local:Strings.ColId}" Width="50" DisplayMemberBinding="{Binding Id}" />
                                <GridViewColumn Header="{x:Static local:Strings.ColUser}" Width="110" DisplayMemberBinding="{Binding User}" />
                                <GridViewColumn Header="{x:Static local:Strings.ColIp}" Width="120" DisplayMemberBinding="{Binding Ip}" />
                                <GridViewColumn Header="{x:Static local:Strings.ColIdle}" Width="85" DisplayMemberBinding="{Binding Idle}" />
                                <GridViewColumn Header="{x:Static local:Strings.ColTransfer}" Width="190" DisplayMemberBinding="{Binding Transfer}" />
                                <GridViewColumn Header="{x:Static local:Strings.ColProgress}" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Minimum="0" Maximum="100" Height="10" Width="90"
                                                         Value="{Binding Progress}"
                                                         Visibility="{Binding HasTransfer, Converter={StaticResource BoolToVisibility}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static local:Strings.ColTimeLeft}" Width="80" DisplayMemberBinding="{Binding TimeLeft}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="DisconnectButton" Content="{x:Static local:Strings.ButtonDisconnect}" Click="OnDisconnect" IsEnabled="False" MinWidth="110" Margin="0,0,8,0" />
                        <Button x:Name="AbortButton" Content="{x:Static local:Strings.ButtonAbort}" Click="OnAbort" IsEnabled="False" MinWidth="130" Margin="0,0,8,0" />
                        <Button x:Name="BanButton" Content="{x:Static local:Strings.ButtonBan}" Click="OnBan" IsEnabled="False" MinWidth="90" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
