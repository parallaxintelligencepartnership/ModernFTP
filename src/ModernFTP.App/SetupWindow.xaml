<Window x:Class="ModernFTP.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModernFTP.App"
        Title="{x:Static local:Strings.SetupTitle}"
        Width="520"
        Height="826"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1,12,1" />
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="260" />
            <Button x:Name="SaveButton" Content="{x:Static local:Strings.SetupSave}" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="{x:Static local:Strings.SetupClose}" IsCancel="True" MinWidth="80" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{x:Static local:Strings.SetupRestartNote}" Opacity="0.7" TextWrapping="Wrap" Margin="2,0,0,8" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <GroupBox Header="{x:Static local:Strings.SetupGroupNetwork}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="{x:Static local:Strings.SetupBindAddress}" Target="{Binding ElementName=BindBox}" />
                    <TextBox x:Name="BindBox" Grid.Column="1" />
                    <Label Grid.Row="1" Content="{x:Static local:Strings.SetupPort}" Target="{Binding ElementName=PortBox}" />
                    <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" />
                    <Label Grid.Row="2" Content="{x:Static local:Strings.SetupPasvRange}" Target="{Binding ElementName=PasvMinBox}" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="PasvMinBox" Width="80" />
                        <TextBlock Text="{x:Static local:Strings.SetupPasvTo}" VerticalAlignment="Center" Margin="8,0" />
                        <TextBox x:Name="PasvMaxBox" Width="80" />
                    </StackPanel>
                    <Label Grid.Row="3" Content="{x:Static local:Strings.SetupPasvIp}" Target="{Binding ElementName=PasvIpBox}" />
                    <TextBox x:Name="PasvIpBox" Grid.Row="3" Grid.Column="1" />
                </Grid>
            </GroupBox>
            <GroupBox Header="{x:Static local:Strings.SetupGroupLimits}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="{x:Static local:Strings.SetupMaxConnections}" Target="{Binding ElementName=MaxConnBox}" />
                    <TextBox x:Name="MaxConnBox" Grid.Column="1" />
                    <TextBlock Grid.Column="2" Text="{x:Static local:Strings.SetupZeroUnlimited}" Opacity="0.7" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Label Grid.Row="1" Content="{x:Static local:Strings.SetupMaxPerIp}" Target="{Binding ElementName=MaxIpBox}" />
                    <TextBox x:Name="MaxIpBox" Grid.Row="1" Grid.Column="1" />
                    <Label Grid.Row="2" Content="{x:Static local:Strings.SetupIdleTimeout}" Target="{Binding ElementName=IdleBox}" />
                    <TextBox x:Name="IdleBox" Grid.Row="2" Grid.Column="1" />
                </Grid>
            </GroupBox>
            <GroupBox Header="{x:Static local:Strings.SetupGroupMessages}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="{x:Static local:Strings.SetupWelcome}" Target="{Binding ElementName=WelcomeBox}" />
                    <TextBox x:Name="WelcomeBox" Grid.Column="1" />
                    <Label Grid.Row="1" Content="{x:Static local:Strings.SetupGoodbye}" Target="{Binding ElementName=GoodbyeBox}" />
                    <TextBox x:Name="GoodbyeBox" Grid.Row="1" Grid.Column="1" />
                    <CheckBox x:Name="HideNameBox" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Content="{x:Static local:Strings.SetupHideServerName}" />
                </Grid>
            </GroupBox>
            <GroupBox Header="{x:Static local:Strings.SetupGroupApp}">
                <StackPanel>
                    <CheckBox x:Name="StartMinBox" Content="{x:Static local:Strings.SetupStartMinimized}" Margin="0,2" />
                    <CheckBox x:Name="StartWinBox" Content="{x:Static local:Strings.SetupStartWithWindows}" Margin="0,2" Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged" />
                    <CheckBox x:Name="StartServerBox" Content="{x:Static local:Strings.SetupStartServerOnLaunch}" Margin="0,2" />
                    <Button x:Name="FirewallButton" Content="{x:Static local:Strings.SetupAddFirewall}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" Click="OnAddFirewall" />
                    <TextBlock x:Name="FirewallStatusText" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.85" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
