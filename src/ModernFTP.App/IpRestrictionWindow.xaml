<Window x:Class="ModernFTP.App.IpRestrictionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModernFTP.App"
        Title="{x:Static local:Strings.IpTitle}"
        Width="520"
        Height="400"
        MinWidth="440"
        MinHeight="340"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="260" />
            <Button Content="{x:Static local:Strings.SetupSave}" IsDefault="False" MinWidth="80" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="{x:Static local:Strings.SetupClose}" IsCancel="True" MinWidth="80" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{x:Static local:Strings.IpAllowComing}" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <Label DockPanel.Dock="Top" Content="{x:Static local:Strings.IpListLabel}" Target="{Binding ElementName=IpBox}" Padding="0" Margin="0,0,0,4" />
                <ListBox x:Name="IpBox" Margin="0,0,14,0" SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown" />
            </DockPanel>
            <StackPanel Grid.Column="1">
                <Label Content="{x:Static local:Strings.IpEntryLabel}" Target="{Binding ElementName=EntryBox}" Padding="0" Margin="0,0,0,4" />
                <TextBox x:Name="EntryBox" Margin="0,0,0,8" KeyDown="OnEntryKeyDown" />
                <Button Content="{x:Static local:Strings.IpAdd}" Margin="0,0,0,6" Click="OnAdd" />
                <Button x:Name="RemoveButton" Content="{x:Static local:Strings.IpRemove}" Click="OnRemove" />
                <TextBlock Text="{x:Static local:Strings.IpEntryHint}" Opacity="0.7" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
