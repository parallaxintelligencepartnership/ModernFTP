    <Copyright>Copyright Parallax Intelligence Partnership, LLC</Copyright>
    <Product>ModernFTP</Product>
    <Version>0.1.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
