<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Company>Parallax Intelligence Partnership, LLC</Company>
    <Authors>Parallax Intelligence Partnership, LLC</Authors>
    <Copyright>Copyright Parallax Intelligence Partnership, LLC</Copyright>
    <Product>ModernFTP</Product>
    <Version>0.1.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Windows release builds publish for win-x64; declaring it everywhere keeps every lock file
         valid when "dotnet publish -r win-x64" restores the whole project graph. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
